// Employee Email KPI Analyzer — local SQLite data model.
// Classification values (strings): FORWARDED | NOT_USEFUL | DUPLICATE | PENDING_REVIEW | OTHER

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Employee {
  id         String   @id @default(cuid())
  employeeId String   @unique
  name       String
  email      String   @unique // stored lower-case; primary matching key
  department String   @default("")
  team       String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  emails     Email[]
}

model Batch {
  id              String   @id @default(cuid())
  number          Int      @unique
  year            Int
  month           Int // 1-12
  createdAt       DateTime @default(now())
  totalParsed     Int      @default(0)
  newEmails       Int      @default(0)
  exactDuplicates Int      @default(0)
  matched         Int      @default(0)
  unmatched       Int      @default(0)
  autoClassified  Int      @default(0)
  needsReview     Int      @default(0)
  warnings        String   @default("[]") // JSON array of strings
  status          String   @default("COMPLETED") // COMPLETED | FAILED
  emails          Email[]

  @@index([year, month])
}

model Email {
  id          String   @id @default(cuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  year        Int // analysis month the email was imported into
  month       Int
  role        String   @default("EMPLOYEE") // EMPLOYEE | NMC (NMC replies/forwards used only as evidence)

  // parsed data
  senderName   String   @default("")
  senderEmail  String   @default("")
  toRecipients String   @default("")
  ccRecipients String   @default("")
  subject      String   @default("")
  sentAt       DateTime? // naive wall-clock time stored as UTC
  body         String   @default("")
  rawSource    String   @default("") // exact pasted text for traceability
  messageId    String?
  contentHash  String   @unique
  conversationKey String @default("")
  isForward    Boolean  @default(false)
  isReply      Boolean  @default(false)
  uncertainFields String @default("[]") // JSON array of field names the parser was unsure about

  // extracted entities (comma separated, lower-case) — used for search & duplicate detection
  incidentIds String @default("")
  serviceIds  String @default("")
  circuitIds  String @default("")
  locations   String @default("")

  // month handling
  outsideMonth  Boolean @default(false)
  monthDecision String  @default("IN_MONTH") // IN_MONTH | INCLUDED | EXCLUDED | REVIEW

  // employee link
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeManual Boolean   @default(false)

  // classification
  autoClass      String   @default("PENDING_REVIEW")
  confidence     Int      @default(0)
  reason         String   @default("")
  finalClass     String   @default("PENDING_REVIEW")
  isManual       Boolean  @default(false) // approved or overridden by the user
  overrideReason String?
  overrideAt     DateTime?

  // business duplicate relationship
  duplicateOfId         String?
  duplicateOf           Email?  @relation("DuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates            Email[] @relation("DuplicateOf")
  duplicateSimilarity   Int?
  duplicateReason       String?
  possibleDuplicateOfId String?
  possibleDuplicateSim  Int?

  // review queue
  reviewStatus  String @default("NEEDS_REVIEW") // OK | NEEDS_REVIEW | REVIEWED
  reviewReasons String @default("[]") // JSON array of reason codes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, month])
  @@index([employeeId])
  @@index([batchId])
  @@index([conversationKey])
  @@index([finalClass])
  @@index([sentAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  summary    String   @default("")
  details    String   @default("{}") // JSON

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String // JSON
}
